<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>space.refinex.agentark</groupId>
        <artifactId>agentark-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>agentark-services</artifactId>
    <packaging>pom</packaging>
    <name>AgentArk Services</name>
    <description>聚合 Gateway、Control、Runtime 和 Scheduler 四个独立部署单元</description>

    <dependencyManagement>
        <dependencies>
            <!-- 导入 AgentArk BOM，统一四个 Server 的内部模块与 Spring 生态版本。 -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>agentark-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>agentark-gateway-server</module>
        <module>agentark-control-server</module>
        <module>agentark-runtime-server</module>
        <module>agentark-scheduler-server</module>
    </modules>
</project>
