# 本文件只列出可调整的非敏感宿主端口，复制为 `.env` 后按需覆盖。
# 所有密码由 `tools/dev-up.sh` 生成到已忽略的 `.secrets/`，禁止在此填写 Secret。

# MySQL 宿主回环端口。
AGENTARK_MYSQL_PORT=3306

# Redis 宿主回环端口。
AGENTARK_REDIS_PORT=6379

# MinIO S3-compatible API 宿主回环端口。
AGENTARK_MINIO_API_PORT=9000

# MinIO 管理控制台宿主回环端口。
AGENTARK_MINIO_CONSOLE_PORT=9001

# Qdrant REST API 宿主回环端口，只在 RAG Profile 中使用。
AGENTARK_QDRANT_HTTP_PORT=6333

# Qdrant gRPC API 宿主回环端口，只在 RAG Profile 中使用。
AGENTARK_QDRANT_GRPC_PORT=6334
