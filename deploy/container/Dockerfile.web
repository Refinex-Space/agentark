# syntax=docker/dockerfile:1.7

# 固定 Node.js 24 构建镜像及多架构摘要。
ARG NODE_IMAGE=node:24.13.1-alpine3.23@sha256:4f696fbf39f383c1e486030ba6b289a5d9af541642fc78ab197e584a113b9c03
# 固定非 Root Nginx 运行镜像及多架构摘要。
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.29.5-alpine3.23-slim@sha256:08c2bc93448bc00d2a2e86cd2f8f729220f1d48b56bbf7f211e117fcfe0c4cb6

# 使用精确 Lockfile 构建 Web 静态产物。
FROM ${NODE_IMAGE} AS builder
# 固定 Web 工程目录。
WORKDIR /workspace/agentark-web
# 先复制依赖清单，稳定利用 BuildKit 缓存。
COPY agentark-web/package.json agentark-web/pnpm-lock.yaml agentark-web/pnpm-workspace.yaml ./
# 激活项目声明的精确 pnpm 版本并安装锁定依赖。
RUN --mount=type=cache,id=agentark-pnpm,target=/pnpm/store \
    corepack enable && corepack prepare pnpm@11.22.0 --activate && \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile
# 复制 Web 源码与构建配置。
COPY agentark-web/ ./
# 执行类型检查和生产构建；单元/E2E 由镜像构建前 CI 单独完成。
RUN pnpm build

# 运行阶段只包含静态文件与最小 Nginx。
FROM ${NGINX_IMAGE} AS runtime
# 镜像来源提交。
ARG VCS_REF=unknown
# 镜像构建时间。
ARG BUILD_DATE=unknown
# 镜像版本。
ARG IMAGE_VERSION=0.1.0
# 写入 OCI 标准元数据。
LABEL org.opencontainers.image.title="AgentArk Web" \
      org.opencontainers.image.description="AgentArk production static web console" \
      org.opencontainers.image.source="https://github.com/refinex/agentark" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0"
# 覆盖默认站点配置，使用 8080 非特权端口和 SPA 回退。
COPY deploy/container/nginx.conf /etc/nginx/conf.d/default.conf
# 复制只读静态产物。
COPY --from=builder --chown=101:101 /workspace/agentark-web/dist/ /usr/share/nginx/html/
# Web 只监听非特权 8080。
EXPOSE 8080
# 健康检查不访问业务 API。
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O - http://127.0.0.1:8080/healthz | grep -q '^ok$' || exit 1
# nginx-unprivileged 固定使用 101 非 Root 用户。
USER 101:101
