<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>space.refinex.agentark</groupId>
    <artifactId>agentark-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>AgentArk Parent</name>
    <description>AgentArk Maven Reactor 与工程治理策略</description>
    <url>https://github.com/Refinex-Space/agentark</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>agentark-bom</module>
        <module>agentark-kernel</module>
        <module>agentark-foundation</module>
        <module>agentark-control</module>
        <module>agentark-knowledge</module>
        <module>agentark-runtime</module>
        <module>agentark-runtime-provider-agentscope</module>
        <module>agentark-scheduling</module>
        <module>agentark-services</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.build.outputTimestamp>2026-08-15T00:00:00Z</project.build.outputTimestamp>
        <agentark.version>${project.version}</agentark.version>
        <agentscope.version>2.0.2</agentscope.version>
        <!-- ArchUnit 仅用于验证模块与包依赖边界。 -->
        <archunit.version>1.5.0</archunit.version>
        <!-- json-sKema 仅用于执行 JSON Schema Draft 2020-12 契约测试。 -->
        <json-skema.version>0.31.0</json-skema.version>
        <spring-boot.version>4.1.0</spring-boot.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <extra-enforcer-rules.version>1.12.0</extra-enforcer-rules.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.5</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.5</maven-failsafe-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
        <license-maven-plugin.version>2.7.1</license-maven-plugin.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 统一管理 Maven Compiler Plugin，固定 Java 21 编译参数。 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>

                <!-- 统一管理 Maven Surefire Plugin，执行单元测试。 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>

                <!-- 统一管理 Maven Failsafe Plugin，执行集成测试。 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>

                <!-- 统一管理 Maven JAR Plugin，生成可复现的模块制品。 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                    <configuration>
                        <outputTimestamp>${project.build.outputTimestamp}</outputTimestamp>
                    </configuration>
                </plugin>

                <!-- 统一管理 Maven Enforcer Plugin，约束构建环境与依赖质量。 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>

                <!-- 统一管理 JaCoCo Maven Plugin，采集并生成测试覆盖率报告。 -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>

                <!-- 统一管理 CycloneDX Maven Plugin，生成聚合 SBOM。 -->
                <plugin>
                    <groupId>org.cyclonedx</groupId>
                    <artifactId>cyclonedx-maven-plugin</artifactId>
                    <version>${cyclonedx-maven-plugin.version}</version>
                </plugin>

                <!-- 统一管理 License Maven Plugin，汇总第三方依赖许可证。 -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>license-maven-plugin</artifactId>
                    <version>${license-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- 使用统一的 Java 21 参数编译全部模块生产与测试源码。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!-- 在测试阶段运行 JUnit Platform 单元测试。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!-- 在 integration-test 与 verify 阶段运行并校验集成测试。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <!-- 将集成测试执行和结果校验绑定到 Maven 标准生命周期。 -->
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 生成时间戳稳定的可复现 JAR 制品。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>

            <!-- 在 validate 阶段集中执行 JDK、Maven、依赖和必需文件约束。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <dependencies>
                    <!-- 扩展 Enforcer 的重复类检查等依赖治理规则。 -->
                    <dependency>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>extra-enforcer-rules</artifactId>
                        <version>${extra-enforcer-rules.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <!-- 执行 AgentArk Maven 构建基线的全部强制规则。 -->
                    <execution>
                        <id>enforce-build-baseline</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,4)</version>
                                </requireMavenVersion>
                                <requireReleaseDeps/>
                                <dependencyConvergence/>
                                <requireUpperBoundDeps/>
                                <banDuplicatePomDependencyVersions/>
                                <banDuplicateClasses>
                                    <findAllDuplicates>true</findAllDuplicates>
                                    <ignoreWhenIdentical>true</ignoreWhenIdentical>
                                </banDuplicateClasses>
                                <requireFilesExist>
                                    <files>
                                        <file>${maven.multiModuleProjectDirectory}/LICENSE</file>
                                        <file>${maven.multiModuleProjectDirectory}/NOTICE</file>
                                    </files>
                                </requireFilesExist>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 汇总 Reactor 第三方依赖许可证，不负责生成 Java 文件头。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <configuration>
                    <!-- 仅用于第三方许可证汇总；标准 Java 文件头由知识门禁精确校验。 -->
                    <!-- 声明本项目主许可证的插件内置标识。 -->
                    <licenseName>apache_v2</licenseName>
                    <!-- 声明许可证汇总元数据中的版权主体。 -->
                    <copyrightOwners>refinex</copyrightOwners>
                    <!-- 声明许可证汇总元数据中的组织名称。 -->
                    <organizationName>refinex</organizationName>
                    <!-- 声明 AgentArk 首次发布年份。 -->
                    <inceptionYear>2026</inceptionYear>
                </configuration>
                <executions>
                    <!-- 在全量验证阶段生成整个 Reactor 的第三方许可证清单。 -->
                    <execution>
                        <id>aggregate-third-party-licenses</id>
                        <!-- 仅在 verify 阶段生成，避免日常编译产生额外输出。 -->
                        <phase>verify</phase>
                        <goals>
                            <!-- 汇总所有模块解析出的第三方依赖许可证。 -->
                            <goal>aggregate-add-third-party</goal>
                        </goals>
                        <configuration>
                            <!-- 将生成物隔离在仓库级 target 目录，禁止纳入版本控制。 -->
                            <outputDirectory>${maven.multiModuleProjectDirectory}/target/generated-resources/licenses</outputDirectory>
                        </configuration>
                        <!-- 只允许父 POM 执行一次，子模块不得重复继承执行。 -->
                        <inherited>false</inherited>
                    </execution>
                </executions>
            </plugin>

            <!-- 为单元测试注入 JaCoCo Agent，并在 verify 阶段生成覆盖率报告。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <!-- 在单元测试前准备 JaCoCo Java Agent。 -->
                    <execution>
                        <id>prepare-unit-tests</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- 在 verify 阶段读取覆盖率数据并生成模块报告。 -->
                    <execution>
                        <id>report-unit-tests</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 在父 Reactor 的 verify 阶段生成 JSON 格式 CycloneDX 聚合 SBOM。 -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <inherited>false</inherited>
                <configuration>
                    <outputFormat>json</outputFormat>
                    <schemaVersion>1.6</schemaVersion>
                    <includeBomSerialNumber>true</includeBomSerialNumber>
                    <includeCompileScope>true</includeCompileScope>
                    <includeRuntimeScope>true</includeRuntimeScope>
                    <includeTestScope>false</includeTestScope>
                </configuration>
                <executions>
                    <!-- 聚合全部生产与运行时依赖并生成仓库级 SBOM。 -->
                    <execution>
                        <id>aggregate-sbom</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
