<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>space.refinex.agentark</groupId>
        <artifactId>agentark-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agentark-foundation</artifactId>
    <packaging>pom</packaging>
    <name>AgentArk Foundation</name>
    <description>聚合职责单一且可独立引入的基础设施 Starter</description>

    <dependencyManagement>
        <dependencies>
            <!-- 导入 AgentArk BOM，统一约束全部 Foundation Starter 的依赖版本。 -->
            <dependency>
                <groupId>space.refinex.agentark</groupId>
                <artifactId>agentark-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>agentark-starter-web</module>
        <module>agentark-starter-security</module>
        <module>agentark-starter-persistence</module>
        <module>agentark-starter-redis</module>
        <module>agentark-starter-storage</module>
        <module>agentark-starter-observability</module>
    </modules>
</project>
