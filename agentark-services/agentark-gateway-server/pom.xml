<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>space.refinex.agentark</groupId>
        <artifactId>agentark-services</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agentark-gateway-server</artifactId>
    <name>AgentArk Gateway Server</name>
    <description>提供基于 Spring Cloud Gateway 的响应式公共入口部署单元</description>

    <dependencies>
        <!-- 提供 Spring Cloud Gateway WebFlux 运行时与非阻塞 HTTP 服务器。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>

        <!-- 提供请求标识、标准错误与 WebFlux 公共 Web 基础。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-web</artifactId>
        </dependency>

        <!-- 提供安全默认的指标、追踪与结构化日志约定。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-observability</artifactId>
        </dependency>

        <!-- 提供严格 Issuer、Audience、JWS 算法和 Principal 转换安全基线。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-security</artifactId>
        </dependency>

        <!-- 提供 Redis 固定窗口限流，不承载 Gateway 业务状态。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-redis</artifactId>
        </dependency>

        <!-- 提供 WebFlux Bearer JWT Resource Server 过滤链。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- 提供健康、Liveness、Readiness 和 Build Info 管理端点。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 提供 Spring Boot 上下文、JUnit 5 和断言测试能力。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 使用真实 Redis 容器验证 Gateway 限流自动装配与原子窗口行为。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 生成可独立启动的 Spring Boot JAR 并写入可追溯构建信息。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- 将普通 JAR 重新打包为包含运行时依赖的可执行 JAR。 -->
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                    <!-- 生成 META-INF/build-info.properties 供 Actuator 安全展示构建元数据。 -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
