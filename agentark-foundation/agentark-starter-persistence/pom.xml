<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>space.refinex.agentark</groupId>
        <artifactId>agentark-foundation</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agentark-starter-persistence</artifactId>
    <name>AgentArk Starter Persistence</name>
    <description>提供 MyBatis-Plus、事务、Flyway 与受控类型映射基线</description>

    <dependencies>
        <!-- 复用 UUIDv7 强类型标识和稳定值对象。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-kernel</artifactId>
        </dependency>

        <!-- 提供条件化自动配置和类型安全配置属性。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- 提供 MyBatis-Plus 的 Spring Boot 4 原生自动配置。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>

        <!-- 提供分页和乐观锁拦截器使用的 SQL 解析能力。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- 提供 HikariCP、DataSource 和 Spring 事务基础设施。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- 提供 Flyway 版本化迁移基础设施，不启用自动建表。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>

        <!-- 提供 Flyway 识别 MySQL 8.4 方言和系统表所需的数据库扩展。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- 提供受控 JSON TypeHandler 使用的 Jackson 3 映射能力。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>

        <!-- 提供不记录 SQL 与参数正文的慢查询计时指标；未装配 Registry 时保持无操作。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 提供 MySQL 8.4 JDBC 驱动，仅供真实数据库契约测试使用。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 提供 MySQL 8.4 Testcontainers 生命周期与 JDBC 地址。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 将 Testcontainers 生命周期接入 JUnit Jupiter。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 提供 ApplicationContextRunner、AssertJ 和 JUnit 5 测试能力。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 发布仅供三平面迁移测试复用的 Testcontainers 测试夹具，不进入生产依赖。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <!-- 生成 classifier 为 tests 的测试夹具 JAR。 -->
                    <execution>
                        <id>persistence-test-fixtures</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
