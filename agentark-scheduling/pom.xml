<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2026 refinex. Licensed under the Apache License, Version 2.0. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>space.refinex.agentark</groupId>
        <artifactId>agentark-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agentark-scheduling</artifactId>
    <name>AgentArk Scheduling</name>
    <description>提供 Scheduling 领域、应用与所属 MySQL 持久化边界</description>

    <dependencyManagement>
        <dependencies>
            <!-- 导入 AgentArk BOM，统一管理 Spring Boot、MyBatis-Plus、Testcontainers 与内部模块版本。 -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>agentark-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 提供 JobId、租户强类型标识、Checksum 与 ObjectRef 等中立契约。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-kernel</artifactId>
        </dependency>

        <!-- 复用 Phase 14 中立 Knowledge 摄取 Worker 与结果契约，不访问 Control 数据库。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-knowledge</artifactId>
        </dependency>

        <!-- 提供 Scheduler 管理 API、RFC 9457 错误与统一 JSON 配置。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-web</artifactId>
        </dependency>

        <!-- 提供 Scheduler 管理 API 使用的中立 Principal 与租户选择。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-security</artifactId>
        </dependency>

        <!-- 提供队列深度、最老任务年龄和执行结果等低基数指标能力。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-observability</artifactId>
        </dependency>

        <!-- 提供 Scheduler 所属 MyBatis-Plus、Flyway、事务与受控类型处理能力。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-persistence</artifactId>
        </dependency>

        <!-- 提供 Scheduler Server 连接 MySQL 8.4 的运行时 JDBC 驱动。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 复用三平面一致的 MySQL 迁移测试夹具，不进入生产制品。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-persistence</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- 提供 Scheduler Migration 测试使用的 MySQL 8.4 容器。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 将 Testcontainers 生命周期接入 Scheduler 的 JUnit Jupiter 测试。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 提供 Scheduler 持久化测试的 JUnit、AssertJ 与 Spring 测试支持。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 验证 Scheduler 领域、应用、Adapter 与服务依赖边界不发生反向漂移。 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
