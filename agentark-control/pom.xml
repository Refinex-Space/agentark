<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>space.refinex.agentark</groupId>
        <artifactId>agentark-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agentark-control</artifactId>
    <name>AgentArk Control</name>
    <description>提供 Control 领域、应用与所属 MySQL 持久化边界</description>

    <dependencyManagement>
        <dependencies>
            <!-- 导入 AgentArk BOM，统一管理 Spring Boot、MyBatis-Plus、Testcontainers 与内部模块版本。 -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>agentark-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 提供 Organization/Project/Environment 与 IAM 强类型 UUIDv7 标识。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-kernel</artifactId>
        </dependency>

        <!-- 提供 OIDC/JWT 主体、API Key 认证扩展点和 Tenant Selection 契约。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-security</artifactId>
        </dependency>

        <!-- 提供 RFC 9457、请求上下文、租户上下文和强类型 ID JSON 映射。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-web</artifactId>
        </dependency>

        <!-- 提供 Control 所属 MyBatis-Plus、Flyway、事务与受控类型处理能力。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-persistence</artifactId>
        </dependency>

        <!-- 提供 Skill Artifact 的受控上传、完整性校验和非授权 ObjectRef。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-storage</artifactId>
        </dependency>

        <!-- 提供 Control 发布、部署和治理关键 Span 与低基数指标。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-observability</artifactId>
        </dependency>

        <!-- 提供 Control IAM Controller、Servlet 安全过滤链和 Bean Validation 运行时。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 提供 Control Server 连接 MySQL 8.4 的运行时 JDBC 驱动。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 复用三平面一致的 MySQL 迁移测试夹具，不进入生产制品。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-persistence</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- 提供 Control Migration 测试使用的 MySQL 8.4 容器。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 将 Testcontainers 生命周期接入 Control 的 JUnit Jupiter 测试。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 提供 Control 持久化测试的 JUnit、AssertJ 与 Spring 测试支持。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 提供 MockMvc 的已认证主体注入和 Security 断言。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
