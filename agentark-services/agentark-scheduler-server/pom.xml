<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>space.refinex.agentark</groupId>
        <artifactId>agentark-services</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agentark-scheduler-server</artifactId>
    <name>AgentArk Scheduler Server</name>
    <description>提供定时工作器与最小管理端点的 Scheduler Plane 独立部署单元</description>

    <dependencies>
        <!-- 提供 Actuator 管理端点所需的最小 Spring MVC HTTP 运行时。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 提供请求标识、标准错误与 MVC 公共 Web 基础。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-web</artifactId>
        </dependency>

        <!-- 提供安全默认的指标、追踪与结构化日志约定。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-observability</artifactId>
        </dependency>

        <!-- 提供 Scheduling 领域边界，不在本服务壳引入 Harness。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-scheduling</artifactId>
        </dependency>

        <!-- 提供 Scheduler 管理 API 的 JWT Principal、租户选择与安全失败默认。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-security</artifactId>
        </dependency>

        <!-- 为 Scheduler Servlet API 提供 Bearer JWT Resource Server 过滤链。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- 在部署单元显式装配 Scheduler 所属 MyBatis-Plus、Flyway 与事务能力。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-persistence</artifactId>
        </dependency>

        <!-- 提供 Scheduler Server 连接 MySQL 8.4 的运行时 JDBC 驱动。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 提供健康、Liveness、Readiness 和 Build Info 管理端点。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 提供 Spring Boot 上下文、JUnit 5 和断言测试能力。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 生成可独立启动的 Spring Boot JAR 并写入可追溯构建信息。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- 将普通 JAR 重新打包为包含运行时依赖的可执行 JAR。 -->
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                    <!-- 生成 META-INF/build-info.properties 供 Actuator 安全展示构建元数据。 -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
