  "fieldMappings": [
    {
      "go": "cp.users(username, roles_csv)",
      "java": "user_identity + membership + role_binding",
      "rule": "只映射外部 issuer/subject；不迁密码摘要或本地登录"
    },
    {
      "go": "cp.environments(environment_id, owner_id, type, config_json)",
      "java": "environment(id, organization_id, project_id, environment_key)",
      "rule": "Owner 通过受控 ownerMappings 解析 Project，type/config 转 Profile 引用"
    },
    {
      "go": "cp.agents + cp.agent_versions.snapshot_json",
      "java": "agent + agent_draft + agent_revision + agent_revision_snapshot",
      "rule": "逐版本映射 Draft 并 Publish；Checkpoint 保留 sourceVersion/sourceSnapshotHash/targetSnapshotHash"
    },
    {
      "go": "cp.vaults + cp.vault_credentials",
      "java": "secret_metadata + secret_binding",
      "rule": "只迁 Provider 引用；ciphertext、Master Key 和值禁止进入导出"
    },
    {
      "go": "cp.deployments(trigger_type, cron_expression, webhook_token)",
      "java": "deployment + scheduler trigger/job",
      "rule": "Revision 指针归 Control；Cron/Webhook 执行归 Scheduler；webhook_token 不迁"
    },
    {
      "go": "cp.sessions + rt.sessions/session_events/session_turns",
      "java": "runtime_session/runtime_turn/runtime_run/runtime_event",
      "rule": "活动 Session 固定 Go Owner 排空；终态历史只读归档，不伪造成新 Run"
    },
    {
      "go": "rt.data_planes",
      "java": "runtime_instance",
      "rule": "不复制旧心跳；Java Runtime 以新 Service Identity 重新注册"
    },
    {
      "go": "rt.dp_kv/dp_locks/dp_snapshots/dp_bus_entries/dp_async_tools",
      "java": "AgentState/Checkpoint/Lease/WorkQueue/ObjectStore Ports",
      "rule": "拒绝表翻译和双写；按权威 Owner 迁移状态或归档"
    }
  ],
  "statusMappings": {
    "session.active|idle|running|busy|waiting|paused": "GO_UNTIL_TERMINAL",
    "session.completed|failed|cancelled|terminated|archived": "ARCHIVE_ONLY",
    "deployment.enabled": "ENABLED",
    "deployment.disabled": "DISABLED",
    "agent.archived_at!=null": "ARCHIVED",
    "agent.archived_at==null": "ACTIVE"
  },
  "errorMappings": {
    "400": "RFC9457 validation ProblemDetail",
    "401": "unauthenticated ProblemDetail",
    "403": "scope-aware authorization ProblemDetail",
    "404": "tenant-safe not-found ProblemDetail",
    "409 busy|conflict": "stable conflict ProblemDetail",
    "501 unsupported": "capability mismatch ProblemDetail",
    "503 unreachable": "dependency unavailable ProblemDetail"
  },
  "paginationMappings": {
    "go": "metadata.continue 或 limit/before",
    "java": "opaque cursor + limit + hasMore",
