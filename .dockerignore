# 默认拒绝将仓库内容发送到 Docker 构建上下文。
**

# 只允许共用 Server 镜像模板进入构建上下文。
!deploy/
!deploy/compose/
!deploy/compose/Dockerfile.service

# 只允许四个 Maven 可执行 JAR 进入构建上下文。
!agentark-services/
!agentark-services/agentark-gateway-server/
!agentark-services/agentark-gateway-server/target/
!agentark-services/agentark-gateway-server/target/agentark-gateway-server-*.jar
!agentark-services/agentark-control-server/
!agentark-services/agentark-control-server/target/
!agentark-services/agentark-control-server/target/agentark-control-server-*.jar
!agentark-services/agentark-runtime-server/
!agentark-services/agentark-runtime-server/target/
!agentark-services/agentark-runtime-server/target/agentark-runtime-server-*.jar
!agentark-services/agentark-scheduler-server/
!agentark-services/agentark-scheduler-server/target/
!agentark-services/agentark-scheduler-server/target/agentark-scheduler-server-*.jar
