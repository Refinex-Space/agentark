<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>space.refinex.agentark</groupId>
        <artifactId>agentark-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agentark-runtime</artifactId>
    <name>AgentArk Runtime</name>
    <description>提供供应商中立 Runtime 领域、应用与所属 MySQL 持久化边界</description>

    <dependencyManagement>
        <dependencies>
            <!-- 导入 AgentArk BOM，统一管理 Spring Boot、MyBatis-Plus、Testcontainers 与内部模块版本。 -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>agentark-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 复用 Session、Turn、Run、Approval、Revision、Snapshot、ObjectRef 与 Checksum 强类型契约。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-kernel</artifactId>
        </dependency>

        <!-- 提供 Phase 13 WebFlux Controller、SSE 与响应式流入口；保持可选以免 Provider 传递引入 Web 层。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 提供 Runtime API 请求的 Jakarta Bean Validation 约束与 WebFlux 校验集成。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 复用 AgentArk Principal 与租户选择语义；保持可选以维持 Runtime 中立依赖边界。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-security</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 复用带 Owner/Fencing 校验的 Redis Lease 原子语义；Redis 仍不保存权威运行状态。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 将超过内联阈值的 Runtime Event 载荷写入受控 ObjectRef；保持可选以保护 Provider 边界。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-storage</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 提供 Runtime 所属 MyBatis-Plus、Flyway、事务与受控类型处理能力。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-persistence</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 提供 Runtime Server 连接 MySQL 8.4 的运行时 JDBC 驱动。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- 复用三平面一致的 MySQL 迁移测试夹具，不进入生产制品。 -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agentark-starter-persistence</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- 提供 Runtime Migration 测试使用的 MySQL 8.4 容器。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 将 Testcontainers 生命周期接入 Runtime 的 JUnit Jupiter 测试。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 提供 Runtime 持久化测试的 JUnit、AssertJ 与 Spring 测试支持。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 提供 SSE 背压、重连与 Worker 响应式行为的 StepVerifier 测试能力。 -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
